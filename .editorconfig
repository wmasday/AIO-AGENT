root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,jsonc,md}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_style = tab

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
